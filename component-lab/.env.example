# Offline components never load this file. Optional smoke scripts load .env.
# Never place a real key in this committed example.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_component_lab
QDRANT_VECTOR_SIZE=384

LLM_BASE_URL=http://127.0.0.1:3458/v1
LLM_API_KEY=replace-with-placeholder
LLM_MODEL_ID=replace-with-general-chat-model

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-random-password
NEO4J_DATABASE=neo4j
NEO4J_NAMESPACE=default
